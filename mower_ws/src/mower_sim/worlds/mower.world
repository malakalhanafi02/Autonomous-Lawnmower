<sdf version="1.6">
  <world name="default">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>200</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>1.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Lawn plane -->
    <model name="lawn_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>16 16</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>16 16</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
            <ambient>0.35 0.55 0.35 1</ambient>
            <diffuse>0.45 0.70 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bounded lawn (fence walls) -->
    <model name="fence_north">
      <static>true</static>
      <pose>0 8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 0.2 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 0.2 0.7</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/WoodFloor</name>
            </script>
            <ambient>0.35 0.25 0.16 1</ambient>
            <diffuse>0.55 0.38 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="fence_south">
      <static>true</static>
      <pose>0 -8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 0.2 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>16 0.2 0.7</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/WoodFloor</name>
            </script>
            <ambient>0.35 0.25 0.16 1</ambient>
            <diffuse>0.55 0.38 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="fence_east">
      <static>true</static>
      <pose>8 0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 16 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 16 0.7</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/WoodFloor</name>
            </script>
            <ambient>0.35 0.25 0.16 1</ambient>
            <diffuse>0.55 0.38 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="fence_west">
      <static>true</static>
      <pose>-8 0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 16 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 16 0.7</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/WoodFloor</name>
            </script>
            <ambient>0.35 0.25 0.16 1</ambient>
            <diffuse>0.55 0.38 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Concrete no-cut patch -->
    <model name="concrete_patch">
      <static>true</static>
      <!-- Keep this as a visual-only surface marker.
           It should not act as a physical curb/obstacle. -->
      <pose>2 2 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4 3 0.001</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Randomized-looking obstacle set -->
    <model name="random_obstacle_box_1">
      <static>true</static>
      <pose>3 -2 0.4 0 0 0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.6 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="random_obstacle_box_2">
      <static>true</static>
      <pose>-4 -3 0.4 0 0 0.2</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.6 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.6 0.8</size></box></geometry>
          <material><ambient>0.2 0.4 0.2 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="random_obstacle_cyl_1">
      <static>true</static>
      <pose>-2 1 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.5 1</ambient><diffuse>0.3 0.3 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="random_obstacle_cyl_2">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.5 0.4 0.1 1</ambient><diffuse>0.7 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
