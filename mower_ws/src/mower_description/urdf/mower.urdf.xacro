<?xml version="1.0"?>
<robot name="mower" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="diff_wheel_accel" default="4.0"/>
  <xacro:arg name="diff_wheel_torque" default="260.0"/>
  <xacro:arg name="lidar_mount_z" default="0.125"/>
  <xacro:arg name="lidar_min_range" default="0.12"/>
  <xacro:arg name="camera_pitch" default="0.15"/>

  <!-- ================= BASE FOOTPRINT ================= -->
  <link name="base_footprint"/>

  <!-- ================= BASE LINK ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.5 0.2"/>
      </geometry>
      <material name="mower_blue">
        <color rgba="0.06 0.28 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.5 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1" iyy="1" izz="1"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="base_link">
    <selfCollide>false</selfCollide>
    <!-- Extra velocity decay reduces unrealistic coasting in simulation. -->
    <velocityDecay>
      <linear>0.25</linear>
      <angular>0.35</angular>
    </velocityDecay>
  </gazebo>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Keep base_footprint on ground; raise base_link to wheel-axle/body frame. -->
    <origin xyz="0 0 0.15"/>
  </joint>

  <!-- ================= LIDAR ================= -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="sensor_black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- mount on top-front of chassis -->
    <origin xyz="0.25 0 $(arg lidar_mount_z)" rpy="0 0 0"/>
  </joint>

  <!-- ================= IMU ================= -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.03 0.02"/>
      </geometry>
      <material name="sensor_black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.03 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- mount near center/top -->
    <origin xyz="0 0 0.11" rpy="0 0 0"/>
  </joint>

  <!-- ================= CAMERA ================= -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.03 0.03"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- underside-front mount with mild downward pitch for close grass visibility -->
    <origin xyz="0.30 0 -0.08" rpy="0 $(arg camera_pitch) 0"/>
  </joint>

  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <!-- REP-103 optical frame: +Z forward, +X right, +Y down -->
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- ================= GPS MODULE ================= -->
  <link name="gps_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.05 0.02"/>
      </geometry>
      <material name="sensor_black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.05 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.22 0 0.11" rpy="0 0 0"/>
  </joint>

  <!-- ================= WHEEL MACROS ================= -->
  <xacro:macro name="wheel_link" params="name mass">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.05"/>
        </geometry>
        <material name="${name}_color">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.05"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="0.002604" iyy="0.002604" izz="0.005000"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="idler_wheel" params="name x y axis_sign">
    <xacro:wheel_link name="${name}" mass="0.45"/>

    <gazebo reference="${name}">
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>
      <!-- Front idlers should roll easily and not dominate yaw dynamics. -->
      <mu1>0.08</mu1>
      <mu2>0.01</mu2>
      <kp>60000.0</kp>
      <kd>1.5</kd>
      <minDepth>0.0007</minDepth>
      <slip1>1.20</slip1>
      <slip2>3.50</slip2>
    </gazebo>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} -0.05"/>
      <axis xyz="0 ${axis_sign} 0"/>
      <!-- Idlers are passive -->
      <limit effort="5.0" velocity="30.0"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="drive_wheel" params="name x y axis_sign">
    <xacro:wheel_link name="${name}" mass="1.0"/>

    <gazebo reference="${name}">
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>
      <mu1>1.10</mu1>
      <mu2>0.10</mu2>
      <kp>70000.0</kp>
      <kd>1.8</kd>
      <minDepth>0.0008</minDepth>
      <slip1>0.03</slip1>
      <slip2>0.65</slip2>
    </gazebo>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} -0.05"/>
      <axis xyz="0 ${axis_sign} 0"/>
      <!-- Rear motorized wheels -->
      <limit effort="120.0" velocity="30.0"/>
      <!-- Rear wheel damping acts like motor braking in simulation. -->
      <dynamics damping="0.80" friction="0.0"/>
    </joint>

    <transmission name="${name}_trans">
       <type>transmission_interface/SimpleTransmission</type>
      <joint name="${name}_joint">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="${name}_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <!-- ================= 4 WHEELS ================= -->
  <!-- Front are passive idlers, rear are driven -->
  <!-- Keep wheel-axis sign consistent so drive plugins map left/right commands predictably. -->
  <xacro:idler_wheel name="front_left_wheel"  x="0.25"  y="0.25"  axis_sign="1"/>
  <xacro:idler_wheel name="front_right_wheel" x="0.25"  y="-0.25" axis_sign="1"/>
  <xacro:drive_wheel name="rear_left_wheel"   x="-0.25" y="0.25"  axis_sign="1"/>
  <xacro:drive_wheel name="rear_right_wheel"  x="-0.25" y="-0.25" axis_sign="1"/>
  <!-- Wheel coloring in Gazebo -->
  <gazebo reference="front_left_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="front_right_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rear_left_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rear_right_wheel"><material>Gazebo/Black</material></gazebo>
  <!-- ================= CUTTER ================= -->
  <link name="cutter">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.02"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.25" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.05" iyy="0.05" izz="0.05"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="cutter_joint" type="continuous">
    <parent link="base_link"/>
    <child link="cutter"/>
    <origin xyz="0 0 -0.1"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <transmission name="cutter_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="cutter_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="cutter_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- ================= GAZEBO CONTROL ================= -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so"/>
  </gazebo>
  <!-- Rear-wheel differential drive in Gazebo. Front wheels are passive idlers. -->
  <gazebo>
    <plugin name="sim_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>80</updateRate>
      <robotNamespace></robotNamespace>
      <leftJoint>rear_left_wheel_joint</leftJoint>
      <rightJoint>rear_right_wheel_joint</rightJoint>
      <wheelSeparation>0.5</wheelSeparation>
      <wheelDiameter>0.2</wheelDiameter>
      <wheelAcceleration>$(arg diff_wheel_accel)</wheelAcceleration>
      <wheelTorque>$(arg diff_wheel_torque)</wheelTorque>
      <commandTopic>/cmd_vel</commandTopic>
      <odometryTopic>/odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishOdomTF>false</publishOdomTF>
      <publishWheelJointState>false</publishWheelJointState>
      <legacyMode>false</legacyMode>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>
  
  <!-- Gazebo Ray Sensor publishing /scan -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>$(arg lidar_min_range)</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>

      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>
        <frameName>lidar_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
  
  <!-- Gazebo IMU publishing /imu/data -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <imu>
        <angular_velocity>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </angular_velocity>
        <linear_acceleration>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </linear_acceleration>
      </imu>

      <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu_sensor.so">
        <topicName>/imu/data</topicName>
        <bodyName>imu_link</bodyName>
        <frameName>imu_link</frameName>
        <updateRateHZ>50</updateRateHZ>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <gaussianNoise>0.0</gaussianNoise>
      </plugin>
    </sensor>
  </gazebo>
  
  <!-- Gazebo RGB camera publishing /camera/image_raw and /camera/camera_info -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="mower_camera">
      <!-- camera body is already mounted forward; keep sensor centered in link -->
      <pose>0 0 0 0 0 0</pose>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov> <!-- ~60 degrees -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
      </camera>

      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <cameraName>mower_camera</cameraName>
        <robotNamespace>/</robotNamespace>
  
        <!-- These set the ROS topics -->
        <imageTopicName>camera/image_raw</imageTopicName>
        <cameraInfoTopicName>camera/camera_info</cameraInfoTopicName>
  
        <!-- Frame id in ROS messages -->
        <frameName>camera_optical_link</frameName>
  
        <!-- Optional: make images uncompressed and reliable -->
        <hackBaseline>0.07</hackBaseline>
        <distortionK1>0.0</distortionK1>
        <distortionK2>0.0</distortionK2>
        <distortionK3>0.0</distortionK3>
        <distortionT1>0.0</distortionT1>
        <distortionT2>0.0</distortionT2>
      </plugin>
    </sensor>
  </gazebo>
  
</robot>
